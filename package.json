{
  "name": "tidebound",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A cooperative ocean dungeon arcade game",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "balance": "node scripts/balance.mjs",
    "audio": "node --env-file=.env.local scripts/generate-audio.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
